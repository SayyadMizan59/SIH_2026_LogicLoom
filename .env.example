# ========================================================
# Credexa — Environment Variables Configuration
# ========================================================

# Application Port (Used for local Express server)
PORT=3000

# Environment Mode ("development" or "production")
NODE_ENV=development

# Session Encryption Secret (Use a strong random string in production)
SESSION_SECRET=aetherid_production_secret_key_2026_change_me

# ========================================================
# Blockchain Network Configuration (EVM Compatible)
# ========================================================

# For LOCAL DEVELOPMENT:
# 1. Start Hardhat Node: `npm run node`
# 2. Deploy Contract: `npm run deploy`
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# CONTRACT_ADDRESS is automatically read from deployment.json in local dev, but can be overridden:
# CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ========================================================
# For PRODUCTION / NETLIFY DEPLOYMENT:
# Configure these in: Netlify Dashboard -> Site configuration -> Environment variables
# DO NOT commit real private keys or secrets to GitHub!
# ========================================================
# RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY (or Alchemy / QuickNode / Remote EVM RPC)
# PRIVATE_KEY=your_remote_funded_relayer_private_key
# CONTRACT_ADDRESS=0xYourDeployedContractAddressOnRemoteNetwork
# SESSION_SECRET=your_secure_random_session_secret_min_32_chars
# NODE_ENV=production
